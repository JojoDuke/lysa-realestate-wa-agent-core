# ── OpenRouter (required) ─────────────────────────────────────────────────────
# Use your key during build/demo. At customer handoff, replace with their key.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — shown on openrouter.ai rankings when set
# OPENROUTER_HTTP_REFERER=https://your-company.com
# OPENROUTER_APP_NAME=Your Company WhatsApp Agent

# ── Twilio WhatsApp (required for WhatsApp channel; not needed for Studio) ────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional — used in startup logs only
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Supabase (optional for Mastra Studio / local demos) ───────────────────────
# Leave blank while developing in Studio. Add before production WhatsApp deploy.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Postgres URI for durable Mastra memory (recommended in prod)
# Supabase → Project Settings → Database → Connection string (URI)
SUPABASE_DATABASE_URL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000

# ── Agent ─────────────────────────────────────────────────────────────────────
# Override config/app.json default language: en | cs
# DEFAULT_LANGUAGE=en
