    "@mastra/pg": "^1.11.1",
    "@supabase/supabase-js": "^2.95.3",
    "axios": "^1.13.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "tsx": "^4.21.0",
    "twilio": "^5.11.1",
    "zod": "4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
